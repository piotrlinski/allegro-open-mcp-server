# Allegro MCP server — environment variables.
# Copy to `.env` (which is gitignored) and fill in real values.
#
# Application registration: developer.allegro.pl → My applications → Register
# a new application. Pick the OAuth flow that matches your use case (see
# README "Authentication" section).

# ---- Required ---------------------------------------------------------------

ALLEGRO_CLIENT_ID=your-client-id
ALLEGRO_CLIENT_SECRET=your-client-secret

# Which OAuth flow to use.
#   device              — best fit for MCP. First run prints a URL+code, you
#                         approve it in a browser, the server polls and persists
#                         a refresh token at ~/.allegro-mcp/tokens.json.
#   authcode            — three-legged with PKCE. Spawns a localhost listener
#                         on ALLEGRO_PKCE_CALLBACK_PORT (default 8765).
#   client_credentials  — app-only, two-legged. Public resources only
#                         (categories, marketplaces). No orders/offers.
#   refresh_token       — supply ALLEGRO_REFRESH_TOKEN obtained out-of-band.
#                         No interactive auth at startup.
ALLEGRO_AUTH_FLOW=device

# ---- Conditionally required -------------------------------------------------

# Required when ALLEGRO_AUTH_FLOW=refresh_token.
# ALLEGRO_REFRESH_TOKEN=

# Required when ALLEGRO_AUTH_FLOW=authcode.
# ALLEGRO_REDIRECT_URI=http://127.0.0.1:8765/callback
# ALLEGRO_PKCE_CALLBACK_PORT=8765

# ---- Optional ---------------------------------------------------------------

# Comma-separated list of OAuth scopes to request.
# Full list: developer.allegro.pl/auth → "Available scopes".
# ALLEGRO_SCOPES=allegro:api:sale:offers:read,allegro:api:orders:read

# production | sandbox. Default: production.
# ALLEGRO_ENVIRONMENT=sandbox

# Override base URLs (rare; usually inferred from ALLEGRO_ENVIRONMENT).
# ALLEGRO_API_BASE_URL=https://api.allegro.pl
# ALLEGRO_OAUTH_BASE_URL=https://allegro.pl

# Default marketplace for endpoints that take a marketplace selector.
# ALLEGRO_DEFAULT_MARKETPLACE=allegro-pl

# Accept-Language for response localisation.
# ALLEGRO_ACCEPT_LANGUAGE=pl-PL

# User-Agent override (default: allegro-mcp/<version> (+ repo URL)).
# ALLEGRO_USER_AGENT=

# Where the refresh token is persisted (default: ~/.allegro-mcp/tokens.json).
# ALLEGRO_TOKEN_STORE_PATH=

# httpx request timeout in seconds (default: 30).
# ALLEGRO_TIMEOUT=30

# Max retries on 429 / 5xx / network errors (default: 3).
# ALLEGRO_MAX_RETRIES=3

# Gate high-blast-radius write tools (offer_delete, payment_refund,
# auction_place_bid, …). Default: false.
# ALLEGRO_ENABLE_WRITES=true

# Logging.
# ALLEGRO_LOG_DIR=~/.allegro-mcp/logs
# ALLEGRO_LOG_LEVEL=INFO
# ALLEGRO_LOG_RETENTION_DAYS=7
